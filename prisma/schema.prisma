generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  password    String
  role        String
  shopName    String
  location    String
  shopType    String   @default("provision")
  createdAt   DateTime @default(now())
  lastSyncAt  DateTime @default(now())

  purchaseLogs     PurchaseLog[]
  wholesalerPrices WholesalerPrice[]
  sentMessages     Message[]        @relation("SentMessages")
  retailerThreads  MessageThread[]  @relation("RetailerThreads")
  wholesalerThreads MessageThread[] @relation("WholesalerThreads")
  briefings        Briefing[]
}

model PurchaseLog {
  id             String   @id @default(uuid())
  userId         String
  rawMessage     String
  product        String
  quantity       Float
  quantityUnit   String
  pricePerUnit   Float
  totalPrice     Float
  currency       String   @default("NGN")
  supplier       String?
  supplierType   String   @default("unknown")
  location       String
  timestamp      DateTime @default(now())
  synced         Boolean  @default(true)
  confidenceScore Float   @default(0.8)

  user User @relation(fields: [userId], references: [id])
}

model WholesalerPrice {
  id                String   @id @default(uuid())
  wholesalerId      String
  product           String
  pricePerUnit      Float
  quantityUnit      String
  availableQuantity Float
  location          String
  lastUpdated       DateTime @default(now())
  notes             String?

  wholesaler User @relation(fields: [wholesalerId], references: [id])
}

model MarketIntelligence {
  id          String   @id @default(uuid())
  product     String
  location    String
  period      String   @default("daily")
  priceMin    Float
  priceMax    Float
  priceMedian Float
  priceMean   Float
  buyerCount  Int
  trend       String   @default("stable")
  volatility  Float    @default(0)
  lastUpdated DateTime @default(now())
}

model MessageThread {
  id             String    @id @default(uuid())
  retailerId     String
  wholesalerId   String
  product        String
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime  @default(now())
  status         String    @default("open")

  retailer   User      @relation("RetailerThreads", fields: [retailerId], references: [id])
  wholesaler User      @relation("WholesalerThreads", fields: [wholesalerId], references: [id])
  messages   Message[]
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  text      String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)

  thread MessageThread @relation(fields: [threadId], references: [id])
  sender User          @relation("SentMessages", fields: [senderId], references: [id])
}

model Briefing {
  id        String   @id @default(uuid())
  userId    String
  content   String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
